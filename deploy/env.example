# Copy to .env (git-ignored). Never commit real values; in AWS these come from Secrets Manager.
EDITOS_API_KEYS=change-me-long-random-key
# EDITOS_AUTH_DISABLED=1               # local development only
EDITOS_WORKERS=2
EDITOS_MAX_UPLOAD_MB=50
# EDITOS_ANTHROPIC_API_KEY=            # Claude: reference field split, front matter, copy-edit pass
# NCBI_API_KEY=                        # optional: higher PubMed rate limit
# EDITOS_MAILTO=                       # contact address sent in the User-Agent (CrossRef / OpenAlex polite pools)
# OPENALEX_API_KEY=                    # OpenAlex searches: free key (https://openalex.org); without one the shared
#                                      # free budget is often used up and OpenAlex is skipped
# SEMANTIC_SCHOLAR_API_KEY=            # optional: Semantic Scholar's shared pool answers 429 often without one
# EDITOS_CALLBACK_SECRET=              # signs completion callbacks to the dashboard
# EDITOS_S3_BUCKET=                    # keep job files in S3 (IAM role / AWS_* credentials)
# EDITOS_S3_PREFIX=edit-os/
# AWS_REGION=ap-south-1
# Journal stylesheets (*.txt, one per journal) and the pre-editing guide: client material, never committed.
# The review screen quotes the rule behind each suggestion from them; without them it shows plain descriptions.
# EDITOS_STYLESHEETS=/stylesheets
# EDITOS_PREEDIT_GUIDE=/stylesheets/guide/guide.txt
# EDITOS_STYLESHEETS_S3=s3://<bucket>/stylesheets/   # EC2 (deploy/ec2-deploy.sh): synced into the container
